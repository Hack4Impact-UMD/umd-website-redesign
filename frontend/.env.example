# Absolute API base used for server-side content fetching during the build.
# Required: a same-origin /api path cannot be resolved outside a browser.
# Production is set in netlify.toml's [build.environment], next to the /api
# redirect that has to agree with it.
API_BASE_URL=http://127.0.0.1:5001/demo-umd-website/us-central1/api

# Dev-server proxy target for browser-side /api/media/* requests. Storage rules
# deny public reads, so images are served by the Function even in development.
DEV_API_PROXY_URL=http://127.0.0.1:5001/demo-umd-website/us-central1/api

# Browser-facing API base. Leave unset for same-origin /api, which is what
# production uses so Netlify's proxy and CDN stay in front of the Function.
# PUBLIC_API_URL=
