rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasCmsRole() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'editor'];
    }

    // Relations are maintained bidirectionally. Disallow deleting either side
    // until reverse-relation cleanup is implemented.
    match /projects/{projectId} {
      allow read, create, update: if hasCmsRole();
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read, create, update: if hasCmsRole();
      allow delete: if false;
    }

    // Build bookkeeping written only by the rebuild trigger through the Admin
    // SDK, which bypasses these rules. Denied to every client explicitly: the
    // catch-all below already denies it, but stating it here stops a later
    // widening of that rule from exposing it by accident.
    match /system_build/{documentId} {
      allow read, write: if false;
    }

    // CMS-managed singleton content collections are named content_*.
    match /{collectionName}/{documentId} {
      allow read, write: if hasCmsRole()
        && collectionName.matches('content_.*');
    }
  }
}
