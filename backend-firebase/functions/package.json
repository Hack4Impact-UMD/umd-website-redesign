{
  "name": "backend-firebase-functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "serve": "firebase emulators:start --config ../firebase.json --only functions,firestore,auth,storage",
    "test": "FUNCTIONS_EMULATOR=true GCLOUD_PROJECT=demo-umd-website APP_FIREBASE_STORAGE_BUCKET=demo-umd-website.appspot.com vitest run tests/unit",
    "test:emulator": "FUNCTIONS_EMULATOR=true GCLOUD_PROJECT=demo-umd-website APP_FIREBASE_STORAGE_BUCKET=demo-umd-website.appspot.com vitest run tests/emulator"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.17",
    "@types/supertest": "^6.0.2",
    "firebase": "^11.1.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
