# Firebase project (required outside the emulator)
APP_FIREBASE_PROJECT_ID=your-shared-firebase-project-id
APP_FIREBASE_STORAGE_BUCKET=your-shared-firebase-project-id.firebasestorage.app

# API behavior
API_REGION=us-central1
API_CACHE_MAX_AGE=60
API_CACHE_S_MAX_AGE=300

# Required CSV list for browser clients. Origins must be exact; wildcards and
# path-bearing values are rejected. Local HTTP origins are emulator-only.
ALLOWED_ORIGINS=https://umd.hack4impact.org
