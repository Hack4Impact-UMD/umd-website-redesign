# Firebase project
# Optional override. Defaults to GOOGLE_CLOUD_PROJECT/GCLOUD_PROJECT when available.
APP_FIREBASE_PROJECT_ID=your-shared-firebase-project-id
APP_FIREBASE_STORAGE_BUCKET=your-shared-firebase-project-id.firebasestorage.app

# API behavior
API_REGION=us-central1
API_CACHE_MAX_AGE=60
API_CACHE_S_MAX_AGE=300

# Optional CSV list; if unset CORS allows all origins
ALLOWED_ORIGINS=https://localhost:3000,https://umd.hack4impact.org
